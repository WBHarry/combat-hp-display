 <div class="standard-form settings-menu-container">
    <div class="display-bar-settings-grid {{#if this.barbrawlActive}}bar-brawl{{/if}}">
        <div class="settings-column">
            <label class="flex1" style="text-align: center;"><strong>{{localize "Alliance"}}</strong></label>
            {{#each this.combat as |type key|}}
                <i class="far {{type.icon}} token-display-icon flex0" title="{{this.title}}"></i>
            {{/each}}
        </div>
        <div class="settings-column">
            <label class="flex1" style="text-align: center;"><strong>{{localize "combat-hp-display.hpDisplaySettings.inCombat"}}</strong></label>
            {{#each this.combat as |type key|}}
                <select data-dtype="Number" name="displaySettings.combat.{{key}}.value" class="flex1">
                    {{selectOptions ../displayChoisesTo selected=this.value valueAttr="value" labelAttr="name"}}
                </select>
            {{/each}}
        </div>
        {{#if this.barbrawlActive}}
            <div class="settings-column">
                <label class="flex1" style="text-align: center;"><strong>{{localize "combat-hp-display.hpDisplaySettings.gmOnly"}}</strong></label>
                {{#each this.combat as |type key|}}
                    <input id="gmOnly" type="checkbox" name="displaySettings.combat.{{key}}.gmOnly" data-dtype="Boolean" class="gm-row" {{checked this.gmOnly}} />
                {{/each}}
            </div>
        {{/if}}
    </div>
    <footer>
        <button data-action="save"><i class="far fa-save"></i>Save Changes</button>
    </footer>
 </div>